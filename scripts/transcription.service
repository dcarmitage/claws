[Unit]
Description=Parakeet Transcription Service (nemo-parakeet-tdt-0.6b-v3)
After=network.target

[Service]
Type=simple
ExecStart=/home/clawd/tools/parakeet-env/bin/python3 /home/clawd/scripts/transcription_service.py
WorkingDirectory=/home/clawd/scripts
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Resource limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=default.target
