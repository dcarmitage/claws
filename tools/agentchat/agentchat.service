[Unit]
Description=AgentChat V2 Server
After=network.target

[Service]
Type=simple
User=dcarmitage
Group=dcarmitage
WorkingDirectory=/home/clawd/tools/agentchat
ExecStart=/usr/bin/python3 /home/clawd/tools/agentchat/server.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
