# Claws environment configuration
# Copy to .env and fill in your values

# Repository root (set this to your claws checkout)
CLAWS_HOME=/path/to/claws

# OpenClaw gateway
OPENCLAW_URL=http://localhost:18789/v1/chat/completions
OPENCLAW_TOKEN=your-gateway-token-here

# OpenClaw config (for auto-discovery of token)
OPENCLAW_CONFIG=$HOME/.openclaw/openclaw.json

# AgentChat
AGENTCHAT_SERVER=http://localhost:9090

# Camera service
CAMSERVICE_PORT=5080

# Parakeet STT
PARAKEET_URL=http://localhost:5092
